# ============================================================
# ReadmitAI Clinical Intelligence
# Diabetes Readmission Clinical AI
# Git Ignore Rules
# ============================================================


# ------------------------------------------------------------
# 1. Python virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/


# ------------------------------------------------------------
# 2. Python cache and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ------------------------------------------------------------
# 3. Jupyter temporary files
# ------------------------------------------------------------
.ipynb_checkpoints/


# ------------------------------------------------------------
# 4. IDE / editor files
# ------------------------------------------------------------
.vscode/
.idea/


# ------------------------------------------------------------
# 5. Operating-system files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------------------------
# 6. Raw and derived datasets
# Clinical/source data must never be committed to Git
# ------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*

# Preserve data directory structure only
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep


# ------------------------------------------------------------
# 7. Persisted ML artifacts
# Model/preprocessor binaries are excluded by default.
# Only explicitly governed deployment artifacts are permitted.
# ------------------------------------------------------------
artifacts/models/*
artifacts/preprocessors/*

# Preserve directory structure
!artifacts/models/.gitkeep
!artifacts/preprocessors/.gitkeep


# ------------------------------------------------------------
# 8. Common model / serialization binaries
# Exclude serialized ML artifacts globally by default
# ------------------------------------------------------------
*.joblib
*.pkl
*.pickle
*.onnx


# ------------------------------------------------------------
# 9. ReadmitAI deployment exceptions
# These frozen governed artifacts are required for inference.
# ------------------------------------------------------------
!artifacts/models/D8_selected_development_model.joblib
!artifacts/preprocessors/D7_primary_preprocessor.joblib


# ------------------------------------------------------------
# 10. Secrets and local environment configuration
# ------------------------------------------------------------
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

.streamlit/secrets.toml


# ------------------------------------------------------------
# 11. Logs, audit outputs, and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
~$*

artifacts/audit_logs/*

# Preserve audit-log directory structure if required
!artifacts/audit_logs/.gitkeep


# ------------------------------------------------------------
# 12. Local Streamlit runtime files
# Keep deployable configuration separate from local secrets
# ------------------------------------------------------------
.streamlit/secrets.toml


# ------------------------------------------------------------
# 13. Local coverage / testing outputs
# ------------------------------------------------------------
.coverage
coverage.xml
htmlcov/


# ------------------------------------------------------------
# 14. Build and packaging outputs
# ------------------------------------------------------------
build/
dist/
*.egg-info/